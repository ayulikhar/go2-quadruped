<mujoco model="go2 scene with waypoint">
  <include file="go2.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Waypoint target marker: a mocap body so the Python controller
         can move it to the hover or clicked world coordinates each time.
         Renders as a flat highlighted circle on the surface, used both
         for hover-preview and click-confirmed waypoints.
         contype/conaffinity=0 keep it purely visual. -->
    <body name="target_marker" mocap="true" pos="0 0 0.05">
      <site name="target_site" pos="0 0 0" size="0.05" rgba="0.1 0.9 0.3 1"/>
      <geom name="target_ring_outer" type="cylinder" size="0.20 0.005" pos="0 0 0.006"
            rgba="0.1 0.9 0.3 0.55" contype="0" conaffinity="0"/>
      <geom name="target_ring_inner" type="cylinder" size="0.14 0.006" pos="0 0 0.007"
            rgba="0.1 0.9 0.3 0.9" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
